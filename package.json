{
  "name": "rome-compatibility-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --require ./scripts/tsx-userinfo.cjs --import tsx --test tests/scanner.test.ts tests/github.test.ts tests/security.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "cli": "node --require ./scripts/tsx-userinfo.cjs --import tsx cli/index.ts",
    "network:check": "node --require ./scripts/tsx-userinfo.cjs --import tsx scripts/check-network.ts",
    "probe:prepare": "node --require ./scripts/tsx-userinfo.cjs --import tsx scripts/prepare-probe.ts",
    "hadrian:dry-run": "node --require ./scripts/tsx-userinfo.cjs --import tsx scripts/dry-run-hadrian.ts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@rome-protocol/registry": "github:rome-protocol/rome-registry#v0.1.0",
    "@solidity-parser/parser": "0.20.2",
    "next": "15.5.29",
    "react": "19.1.2",
    "react-dom": "19.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "viem": "2.55.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    }
  }
}
