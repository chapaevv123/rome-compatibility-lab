# Public demo mode is the safe default: browser scans pasted/uploaded Solidity.
NEXT_PUBLIC_SCAN_API_ENABLED=0
ROME_SCAN_API_ENABLED=0

# Enable both flags only after Upstash and the Vercel WAF rule are configured.
# Server-side only. Never prefix these with NEXT_PUBLIC_ or commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional public testnet address for read-only gas estimation. Never put a key here.
ROME_BURNER_ADDRESS=
